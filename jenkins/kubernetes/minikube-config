apiVersion: v1
kind: Config
clusters:
  - name: minikube
    cluster:
      certificate-authority: /run/secrets/minikube_ca
      server: https://host.docker.internal:55622
      tls-server-name: localhost
users:
  - name: minikube
    user:
      client-certificate: /run/secrets/minikube_client_certificate
      client-key: /run/secrets/minikube_client_key
contexts:
  - name: minikube
    context:
      cluster: minikube
      user: minikube
      namespace: default
current-context: minikube
