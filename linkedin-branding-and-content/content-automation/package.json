{
  "name": "linkedin-content-automation",
  "version": "1.0.0",
  "description": "Local daily LinkedIn content generator and optional publisher for Kubernetes, MLOps, Data Science, and IT topics.",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "draft": "node src/index.js --draft",
    "publish": "node src/index.js --publish",
    "publish:next": "node src/index.js --publish-next",
    "publish:date": "node src/publish-calendar-date.js",
    "publish:today": "node src/publish-calendar-date.js",
    "dry-run:today": "node src/publish-calendar-date.js --dry-run",
    "instagram:verify": "node src/publish-instagram-reel.js --verify",
    "instagram:dry-run": "node src/publish-instagram-reel.js --dry-run",
    "instagram:publish": "node src/publish-instagram-reel.js",
    "prepare:100": "node src/index.js --prepare-100",
    "generate:ai-revision": "node scripts/generate-ai-engineer-revision-series.js",
    "schedule:ai-revision": "node scripts/schedule-ai-engineer-revision-series.js",
    "index:all-content": "node scripts/build-all-content-index.js",
    "dedupe:active": "node scripts/deduplicate-active-calendar.js",
    "normalize:ai-revision": "node scripts/normalize-ai-revision-posts.js",
    "render:doodles": "node scripts/render-upcoming-doodles.js",
    "schedule:three-daily": "node scripts/schedule-three-daily-series.js",
    "linkedin:auth": "node src/oauth.js",
    "schedule:cron": "node src/schedule-cron.js",
    "install:cron": "node src/install-cron.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2"
  },
  "license": "MIT"
}
