NODE_ENV=production
HOST=0.0.0.0
PORT=3030
OFFLINE_ONLY=1
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT_MS=90000

# OpenAI Responses API (set LLM_PROVIDER=openai to enable)
LLM_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Durable account storage. Use a PostgreSQL connection string from your host.
# When omitted, local development falls back to data/users.json.
DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_SSL=true
DATABASE_POOL_SIZE=5

# Required in production so login sessions survive server restarts.
SESSION_SECRET=replace-with-a-long-random-secret

# Optional one-time local administrator bootstrap. Leave blank for normal use.
# Use a unique password of at least 12 characters and remove it after first start.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Comma-separated extra browser origins, if a separate frontend calls this API.
# Same-origin requests require no configuration.
ALLOWED_ORIGINS=

# Production requires PostgreSQL by default. This escape hatch is only for an
# explicitly ephemeral demo and must not be used for real public accounts.
ALLOW_FILE_STORAGE_IN_PRODUCTION=false

# Zero-configuration server-side interview persistence. Defaults to
# data/interviews.sqlite when omitted.
SQLITE_PATH=data/interviews.sqlite
